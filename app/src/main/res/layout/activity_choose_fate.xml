<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chooseFateMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    tools:context=".game.ChooseFateActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Top Header -->
            <TextView
                android:id="@+id/tvChooseFateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:text="@string/title_choose_fate"
                android:textColor="@color/blood_red"
                android:textSize="42sp"
                android:textStyle="bold" />

            <!-- SECTION 1: SELECT CATEGORY -->
            <TextView
                android:id="@+id/tvHeaderCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:text="@string/header_select_category"
                android:textColor="@color/subtitle_grey"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <!-- Search Category -->
                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_login_card"
                    android:queryHint="Search for category..."
                    android:iconifiedByDefault="false" />

                <!-- Category Options -->
                <RadioGroup
                    android:id="@+id/rgCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbAnimals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:buttonTint="#B088FF"
                        android:checked="true"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/cat_animals"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:buttonTint="#B088FF" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbObjects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:buttonTint="#B088FF"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/cat_objects"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:buttonTint="#B088FF" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbCelebrities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:buttonTint="#B088FF"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/cat_celebrities"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:buttonTint="#B088FF" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbFood"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#B088FF"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:visibility="gone"
                        android:paddingEnd="10dp"
                        android:text="@string/cat_food"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:buttonTint="#B088FF" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbSports"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:buttonTint="#B088FF"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="SPORTS"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:buttonTint="#B088FF" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbVehicles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:buttonTint="#B088FF"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="VEHICLES"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:buttonTint="#B088FF" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbTechnology"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:buttonTint="#B088FF"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="TECHNOLOGY"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:buttonTint="#B088FF" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbNature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:buttonTint="#B088FF"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="NATURE"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:buttonTint="#B088FF" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbPlaces"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:buttonTint="#B088FF"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="PLACES"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:buttonTint="#B088FF" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbProfessions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#B088FF"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="PROFESSIONS"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:buttonTint="#B088FF" />



                </RadioGroup>

            </LinearLayout>

            <!-- SECTION 2: SELECT TARGET SACRIFICE (DIFFICULTY) -->
            <TextView
                android:id="@+id/tvHeaderDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:text="@string/header_select_difficulty"
                android:textColor="@color/subtitle_grey"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardDifficulty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <RadioGroup
                    android:id="@+id/rgDifficulty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbEasy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:buttonTint="#B088FF"
                        android:checked="true"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/diff_easy"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:buttonTint="#B088FF" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbIntermediate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:buttonTint="#B088FF"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/diff_intermediate"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:buttonTint="#B088FF" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbHard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#B088FF"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/diff_hard"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:buttonTint="#B088FF" />
                </RadioGroup>
            </LinearLayout>

            <!-- SECTION 3: SELECT RITUAL MODE -->
            <TextView
                android:id="@+id/tvHeaderMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:text="@string/header_select_mode"
                android:textColor="@color/subtitle_grey"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <RadioGroup
                    android:id="@+id/rgMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbClassic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:buttonTint="#B088FF"
                        android:checked="true"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/mode_classic"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:buttonTint="#B088FF" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#B088FF"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/mode_timer"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:buttonTint="#B088FF" />
                </RadioGroup>
            </LinearLayout>

            <!-- Bottom Button: ENTER THE ROOM -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnterRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_enter_button"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:minHeight="54dp"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:text="@string/btn_enter_room"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>