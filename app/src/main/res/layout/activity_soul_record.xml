<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/soulRecordMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    tools:context=".SoulRecordActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Top Header -->
            <LinearLayout
                android:id="@+id/soulHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/cardSoulRecord"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvSoulRecordTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:letterSpacing="0.10"
                    android:text="@string/title_soul_record"
                    android:textColor="@color/blood_red"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubjectId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="SUBJECT ID: ADITHYA" />
            </LinearLayout>

            <!-- Center Stats Card -->
            <LinearLayout
                android:id="@+id/cardSoulRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="24dp"
                android:paddingEnd="22dp"
                android:paddingBottom="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/soulHeader">

                <TextView
                    android:id="@+id/tvRitualsPerformed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/text_silver"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="RITUALS PERFORMED: 0" />

                <TextView
                    android:id="@+id/tvEssencesSaved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/text_silver"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="ESSENCES SAVED: 0" />

                <TextView
                    android:id="@+id/tvVictimLosses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/blood_red"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="VICTIM LOSSES: 0" />

                <TextView
                    android:id="@+id/tvStabilityRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/text_silver"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="STABILITY RATE: 0%" />

                <TextView
                    android:id="@+id/tvHighestResonance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="#FFB000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="HIGHEST RESONANCE: 0" />

                <TextView
                    android:id="@+id/tvRescueStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/text_silver"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="RESCUE STREAK: 0" />
            </LinearLayout>

            <!-- Ritual Mastery & Efficiency Card -->
            <LinearLayout
                android:id="@+id/cardMastery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="20dp"
                android:paddingEnd="22dp"
                android:paddingBottom="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardSoulRecord">

                <TextView
                    android:id="@+id/tvMasteryHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="@string/header_ritual_mastery"
                    android:textColor="@color/text_silver"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFlawlessRescues"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="FLAWLESS RESCUES (0 ERRORS): 0" />

                <TextView
                    android:id="@+id/tvCriticalRescues"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="CRITICAL RESCUES (LAST TETHER): 0" />

                <TextView
                    android:id="@+id/tvSalvationRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="#28A745"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="SALVATION RATE: 0%" />
            </LinearLayout>

            <!-- Speed & Precision Card -->
            <LinearLayout
                android:id="@+id/cardSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="20dp"
                android:paddingEnd="22dp"
                android:paddingBottom="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardMastery">

                <TextView
                    android:id="@+id/tvSpeedHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="@string/header_speed_precision"
                    android:textColor="@color/text_silver"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFastestRescue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="FASTEST RESCUE: N/A" />

                <TextView
                    android:id="@+id/tvLetterPrecision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="LETTER PRECISION: 0%" />
            </LinearLayout>

            <!-- Line Graph Performance Trends Card -->
            <LinearLayout
                android:id="@+id/cardGraph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardSpeed">

                <TextView
                    android:id="@+id/tvGraphHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="@string/header_performance_graph"
                    android:textColor="@color/text_silver"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.example.hang.SoulLineGraphView
                    android:id="@+id/graphSoul"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />
            </LinearLayout>

            <!-- Category Progress Breakdown Cards -->



            <!-- Category Progress Breakdown Cards -->
            <TextView
                android:id="@+id/tvHeaderCategoryBreakdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:text="CATEGORY ESSENCES RESCUED"
                android:textColor="@color/subtitle_grey"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardGraph" />

            <GridLayout
                android:id="@+id/layoutCategoryCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="2"
                android:rowCount="5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderCategoryBreakdown">

                <!-- Animals -->
                <TextView
                    android:id="@+id/tvCatAnimalsCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_login_card"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="10dp"
                    android:text="ANIMALS&#10;0 SOLVED"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Objects -->
                <TextView
                    android:id="@+id/tvCatObjectsCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_login_card"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="10dp"
                    android:text="OBJECTS&#10;0 SOLVED"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Celebrities -->
                <TextView
                    android:id="@+id/tvCatCelebritiesCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_login_card"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="10dp"
                    android:text="CELEBRITIES&#10;0 SOLVED"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Food -->
                <TextView
                    android:id="@+id/tvCatFoodCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_login_card"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="10dp"
                    android:text="FOOD&#10;0 SOLVED"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Sports -->
                <TextView
                    android:id="@+id/tvCatSportsCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_login_card"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="10dp"
                    android:text="SPORTS&#10;0 SOLVED"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Vehicles -->
                <TextView
                    android:id="@+id/tvCatVehiclesCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_login_card"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="10dp"
                    android:text="VEHICLES&#10;0 SOLVED"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Technology -->
                <TextView
                    android:id="@+id/tvCatTechnologyCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_login_card"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="10dp"
                    android:text="TECHNOLOGY&#10;0 SOLVED"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Nature -->
                <TextView
                    android:id="@+id/tvCatNatureCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_login_card"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="10dp"
                    android:text="NATURE&#10;0 SOLVED"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Places -->
                <TextView
                    android:id="@+id/tvCatPlacesCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_login_card"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="10dp"
                    android:text="PLACES&#10;0 SOLVED"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Professions -->
                <TextView
                    android:id="@+id/tvCatProfessionsCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_login_card"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="10dp"
                    android:text="PROFESSIONS&#10;0 SOLVED"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </GridLayout>


            <!-- Achievements Section -->
            <LinearLayout
                android:id="@+id/achievementsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/btnReturnSurfaceSoul"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutCategoryCards">

                <TextView
                    android:id="@+id/tvUnlockedMarks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="@string/header_unlocked_marks"
                    android:textColor="@color/subtitle_grey"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNoMarks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_marks_text"
                    android:textColor="#666666"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Bottom Return Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReturnSurfaceSoul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_enter_button"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:minHeight="54dp"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:text="@string/btn_return_surface"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/achievementsLayout" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>