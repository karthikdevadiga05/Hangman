<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gameOverMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    tools:context=".game.GameOverActivity">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/gameOverHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/cardGameOver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <TextView
            android:id="@+id/tvGameOverTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.10"
            android:text="@string/title_too_late"
            android:textColor="@color/blood_red"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGameOverSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/subtitle_too_late"
            android:textColor="@color/blood_red"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Word + Score Card -->
    <LinearLayout
        android:id="@+id/cardGameOver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/bg_login_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toTopOf="@id/buttonsLayoutGameOver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gameOverHeader">

        <!-- Word -->
        <TextView
            android:id="@+id/tvWordWas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.10"
            android:textColor="@color/text_silver"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="THE WORD WAS:\nPELICAN" />

        <!-- Score Divider -->
        <View
            android:layout_width="180dp"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="18dp"
            android:background="@color/text_silver" />

        <!-- Points Earned Label -->
        <TextView
            android:id="@+id/tvPointsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:text="POINTS EARNED"
            android:textColor="@color/blood_red"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Points Earned -->
        <TextView
            android:id="@+id/tvEarnedPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="+0"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="+150" />

        <!-- Total Score Label -->
        <TextView
            android:id="@+id/tvTotalScoreLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:text="TOTAL SCORE"
            android:textColor="@color/blood_red"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Total Score -->
        <TextView
            android:id="@+id/tvTotalScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="1250" />

    </LinearLayout>

    <!-- Bottom Buttons Layout -->
    <LinearLayout
        android:id="@+id/buttonsLayoutGameOver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="36dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTryAgain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_enter_button"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:minHeight="54dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="@string/btn_try_again"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReturnSurfaceGameOver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_enter_button"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:minHeight="54dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="@string/btn_return_surface"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>