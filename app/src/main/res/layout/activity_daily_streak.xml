<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dailyStreakMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    tools:context=".DailyStreakActivity">

    <!-- Top Header -->
    <TextView
        android:id="@+id/tvStreakTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="serif"
        android:letterSpacing="0.10"
        android:text="@string/title_daily_streak"
        android:textColor="@color/blood_red"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Fire Emoji Banner -->
    <LinearLayout
        android:id="@+id/fireBannerLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/cardStreak"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStreakTitle">

        <TextView
            android:id="@+id/tvStreakCountBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:textColor="#FF6600"
            android:textSize="36sp"
            android:textStyle="bold"
            tools:text="🔥 1 DAY STREAK!" />
    </LinearLayout>

    <!-- Stats Card -->
    <LinearLayout
        android:id="@+id/cardStreak"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_login_card"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="24dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btnReturnSurfaceStreak"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fireBannerLayout">

        <TextView
            android:id="@+id/tvCurrentStreakStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.06"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="🔥 CURRENT STREAK: 1 DAYS" />

        <TextView
            android:id="@+id/tvBestStreakStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.06"
            android:textColor="#FFB000"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="BEST STREAK: 1 DAYS" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="#333333" />

        <TextView
            android:id="@+id/tvStreakMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/subtitle_grey"
            android:textSize="14sp"
            tools:text="Ritual maintained today. Return tomorrow to keep the flame alive!" />

    </LinearLayout>

    <!-- Bottom Return Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnReturnSurfaceStreak"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_enter_button"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:minHeight="54dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="@string/btn_return_surface"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>