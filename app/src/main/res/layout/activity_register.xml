<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="always"
    android:scrollbars="vertical"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:id="@+id/registerMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal|center_vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:background="@color/bg_black">

        <!-- Top Header -->
        <TextView
            android:id="@+id/tvRegisterTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.12"
            android:text="@string/title_join_void"
            android:textColor="@color/blood_red"
            android:textSize="42sp"
            android:textStyle="bold" />

        <!-- Register Card -->
        <LinearLayout
            android:id="@+id/cardRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_login_card"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="28dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_grey"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etDesiredUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:autofillHints="name"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_desired_username"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_grey"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etRegisterPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:autofillHints="password"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_grey"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="28dp"
                android:autofillHints="password"
                android:background="@drawable/bg_input_field"
                android:hint="Confirm Password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_grey"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBindSoul"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_enter_button"
                android:letterSpacing="0.08"
                android:text="@string/btn_bind_soul"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Return to Login -->
        <TextView
            android:id="@+id/tvReturnLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.10"
            android:padding="8dp"
            android:text="@string/login_prompt"
            android:textColor="@color/blood_red"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>